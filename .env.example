# Supabase project in Frankfurt (eu-central-1).
# The service-role key is server-only. Never expose it in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notifications. Per-market addresses are still to confirm.
RESEND_API_KEY=
LEAD_NOTIFY_TO=

# Analytics. Shared with caredirect.com. No tags before consent.
# GTM container on caredirect.com today: GTM-5DVP4NM
NEXT_PUBLIC_GTM_ID=GTM-5DVP4NM
# Optional GA4 measurement ID if START has its own property (or configure GA4 inside GTM).
NEXT_PUBLIC_GA4_ID=
