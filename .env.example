# Supabase project in Frankfurt (eu-central-1).
# The service-role key is server-only. Never expose it in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notifications. Per-market addresses are still to confirm.
RESEND_API_KEY=
LEAD_NOTIFY_TO=

# Analytics. Shared with caredirect.com. No tags before consent.
# START stamps site_id=start + page_type/locale/program into the dataLayer — see docs/analytics.md.
# GTM container on caredirect.com today: GTM-5DVP4NM
NEXT_PUBLIC_GTM_ID=GTM-5DVP4NM
# Optional — leave empty when GA4/Ads already fire via GTM (G-91XVB9XE1K / AW-579614461).
NEXT_PUBLIC_GA4_ID=
# Meta Pixel is installed in GTM-5DVP4NM (pixel 219968792384002). Leave empty to avoid double-firing.
NEXT_PUBLIC_META_PIXEL_ID=
